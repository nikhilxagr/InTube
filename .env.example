# ==========================================
# InTube - Media Downloader Configuration
# ==========================================

# ------------------------------------------
# Backend Server Configuration (server/.env)
# ------------------------------------------
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173

# Processing & Limits
MAX_FILE_SIZE_MB=100
MAX_PROCESSING_TIME_MS=120000
MAX_TEMP_STORAGE_MB=1024
MAX_CONCURRENT_JOBS=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
DOWNLOAD_RATE_LIMIT_MAX=20

# Paths (Optional overrides)
TEMP_DIR=./temp
FFMPEG_PATH=

# Structured Logging
LOG_LEVEL=info

# ------------------------------------------
# Frontend Client Configuration (client/.env)
# ------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME="InTube Media Utility"
